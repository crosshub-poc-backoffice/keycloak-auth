# cp .env.example .env 후 값 채우기. .env는 git에 올리지 않는다.
KC_DB_PASSWORD=change-me
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=change-me
# 두 client secret. BACKOFFICE_WEB_* = FE .env 의 KEYCLOAK_CLIENT_SECRET, BACKOFFICE_SVC_* = BE .env 의 KEYCLOAK_ADMIN_CLIENT_SECRET 과 같은 값
# 새로 만들 때: openssl rand -base64 32
BACKOFFICE_WEB_CLIENT_SECRET=
BACKOFFICE_SVC_CLIENT_SECRET=
# 백채널 로그아웃 받을 FE 주소 (Keycloak 컨테이너에서 접근 가능한 주소). 비우면 로컬 기본값
# BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3000/api/auth/keycloak/backchannel-logout
# 고객 realm(idblock) 테스트 고객(test-customer@example.com) 비번. 로컬·개발 전용. 정책: 8자+, 숫자 포함
IDBLOCK_TEST_CUSTOMER_PASSWORD=
