# Keycloak 설정. 이 파일을 .env 로 복사해서 쓴다 (cp .env.example .env). .env 는 git 에 올리지 않는다.
# docker compose 가 이 .env 를 읽어 docker-compose.yml·realm JSON 의 ${...} 자리에 넣는다.
# 기본값이 없다 — 하나라도 빠지면 docker compose up 이 빠진 이름을 알려주고 멈춘다. <...> 는 직접 채운다.

# Keycloak 전용 Postgres 비번
KC_DB_PASSWORD=<비번>

# 최초 관리자 (관리 콘솔 http://localhost:8080/admin)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<비번>

# 두 client secret. 새로 만들 때: openssl rand -base64 32
# TP_OFFICE_PARTNER_WEB_* = FE .env 의 KEYCLOAK_CLIENT_SECRET, TP_OFFICE_PARTNER_SVC_* = BE .env 의 KEYCLOAK_SVC_CLIENT_SECRET 과 같은 값
TP_OFFICE_PARTNER_WEB_CLIENT_SECRET=<secret>
TP_OFFICE_PARTNER_SVC_CLIENT_SECRET=<secret>

# 로그아웃 알림(백채널 로그아웃)을 받을 FE 주소. Keycloak 컨테이너 안에서 접근할 수 있는 주소 (로컬은 host.docker.internal = 내 PC)
BACKCHANNEL_LOGOUT_URL=http://host.docker.internal:3000/api/auth/keycloak/backchannel-logout

# 고객 realm(idblock) 테스트 고객(test-customer@example.com) 비번. 로컬·개발 전용. 정책: 8자+, 숫자 포함
IDBLOCK_TEST_CUSTOMER_PASSWORD=<비번>
